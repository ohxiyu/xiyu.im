# ============================================
# 构建模式
# ============================================
# 默认全量静态：构建期一次性生成所有页面，运行时不再回源 Notion，
# ISR 写入为零。发文后需触发一次重新构建才会上线。
# 只有确需回到 ISR 模式（页面自动按间隔再生）时才设为 false。
# FULL_STATIC=false
# 下面两个间隔仅在 FULL_STATIC=false 时生效
# NEXT_PUBLIC_REVALIDATE_SECOND=3600
# NEXT_PUBLIC_SEARCH_REVALIDATE_SECOND=86400

# ============================================
# Notion 非官方 API 登录态（可选，排障用）
# ============================================
# 正常情况：数据库「分享到网络」后无需鉴权即可读取，这两项留空。
# 需要填写的情况：
#   - 数据库不公开
#   - Notion 对 Vercel 机房 IP 返回 403 Forbidden
# 获取方式：浏览器登录 notion.so → F12 → Application → Cookies → 复制 token_v2
# ⚠️ token_v2 等同于账号登录凭证，只能放 Vercel 环境变量，切勿提交进仓库
NOTION_TOKEN_V2=
# 多账号时填对应的 Notion 用户 ID，单账号可留空
NOTION_ACTIVE_USER=

# ============================================
# Notion 域名（迁移适配）
# ============================================
# Notion 已把主域从 notion.so 迁到 notion.com。
# 若构建报 `loadPageChunk: 403 Forbidden`，优先试这两个：
# API_BASE_URL=https://www.notion.com/api/v3
# NEXT_PUBLIC_NOTION_HOST=https://www.notion.com
# 两个要一起改：前者是 API 地址，后者是图片/附件地址。
# 发往 Notion 的 User-Agent，默认伪装成常规浏览器。
# Notion 反爬会 403 掉不带 UA 的请求；需要更新浏览器标识时可覆盖。
NOTION_USER_AGENT=
# Notion 请求节奏（构建被 429 限流时可调）
NOTION_CONCURRENCY=3          # 并发数，越小越不容易被限流
NOTION_REQUEST_INTERVAL=250   # 批量请求间隔(ms)
NOTION_MAX_RETRY=6            # 429 重试次数（指数退避 1s→30s）
