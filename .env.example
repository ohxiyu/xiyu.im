# ============================================
# 付费阅读（USDT）
# 在 Notion 文章数据库加一个数字列 price，填价格即变付费文章；留空 = 免费
# ============================================
# 收款地址（BSC 与 ERC20 同为 EVM 链，共用一个地址）
PAYWALL_EVM_ADDRESS=
PAYWALL_TRON_ADDRESS=
# 签发解锁凭证用的密钥，随便一串长随机字符串（≥16 位），泄漏后别人可伪造凭证
PAYWALL_JWT_SECRET=
# 订单表（Notion 官方 integration token + 数据库 ID），不配则不做交易去重
NOTION_API_KEY=
PAYWALL_ORDERS_DB_ID=
# 可选
PAYWALL_PREVIEW_BLOCKS=2        # 免费预览段落数
PAYWALL_MAX_AGE_DAYS=30         # 超过多少天的付款不再接受
PAYWALL_TOKEN_TTL_SEC=          # 凭证有效期秒数，留空 = 永久
PAYWALL_BSC_RPC=                # 留空用公共节点
PAYWALL_ETH_RPC=
PAYWALL_TRON_API=
PAYWALL_TRON_API_KEY=           # TronGrid API key，可选

# ============================================
# ISR 写入额度控制（Vercel 免费版 200,000 次/月）
# ============================================
# 页面自动再生间隔（秒）。这个值直接决定 ISR 写入量：
# 一个持续有流量的页面每 N 秒就重新生成并写一次缓存。
# 60 → 单页每天约 1440 次写入，几个页面就能打满免费额度
# 3600（默认）→ 同样流量下降到 1/60
NEXT_PUBLIC_REVALIDATE_SECOND=3600
# 搜索结果页专用间隔。/search/[keyword] 关键词空间无界，
# 每个新关键词都会现场生成并写一次缓存，单独给很长的间隔
NEXT_PUBLIC_SEARCH_REVALIDATE_SECOND=86400
# 按需刷新密钥。配置后可调 /api/revalidate?secret=xxx&path=/xxx
# 立刻刷新指定页面，不必为了「更新快」而调低上面的间隔。
# 不配置则该接口关闭（返回 503）
REVALIDATE_SECRET=

# ============================================
# Notion 非官方 API 登录态（可选，排障用）
# ============================================
# 正常情况：数据库「分享到网络」后无需鉴权即可读取，这两项留空。
# 需要填写的情况：
#   - 数据库不公开
#   - Notion 对 Vercel 机房 IP 返回 403 Forbidden
# 获取方式：浏览器登录 notion.so → F12 → Application → Cookies → 复制 token_v2
# ⚠️ token_v2 等同于账号登录凭证，只能放 Vercel 环境变量，切勿提交进仓库
NOTION_TOKEN_V2=
# 多账号时填对应的 Notion 用户 ID，单账号可留空
NOTION_ACTIVE_USER=
